datasource db {
    provider = "postgresql"
    url      = env("NEXT_PUBLIC_DIRECT_URL_2")
}

generator client {
    provider = "prisma-client-js"
    output   = "./generated/prisma-client-js"
}

model users {
    id         Int      @id @default(autoincrement())
    email      String   @unique
    name       String?
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}
