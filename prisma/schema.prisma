datasource db {
    provider  = "postgresql"
    url       = env("NEXT_PUBLIC_DATABASE_URL")
    directUrl = env("NEXT_PUBLIC_DIRECT_URL")
}

generator client {
    provider = "prisma-client-js"
    output   = "./generated/prisma-client-js"
}

model users {
    id    Int     @id @default(autoincrement())
    email String  @unique
    name  String?

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    spaces        spaces[]
    queue_members queue_members[]
    space_owners  space_owners[]
    /**
     * queues        queues[]
     */
}

model spaces {
    id   Int    @id @default(autoincrement())
    name String

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    subject   String
    is_active Boolean

    created_by users @relation(fields: [users_id], references: [id])
    users_id   Int

    is_deleted Boolean   @default(false)
    deleted_at DateTime?

    slug                    String
    spaces_activation_times spaces_activation_times[]
    queues                  queues[]
    queue_members           queue_members[]
    space_owners            space_owners[]
}

model spaces_activation_times {
    id Int @id @default(autoincrement())

    space_id Int
    space    spaces @relation(fields: [space_id], references: [id])

    day_of_week String
    start_time  String

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}

model queues {
    id Int @id @default(autoincrement())

    space    spaces @relation(fields: [space_id], references: [id])
    space_id Int

    start_at_day  String
    start_at_time String
    end_at_time   String?
    is_active     Boolean         @default(true)
    queue_members queue_members[]

    /**
     * user_activator_id Int
     * user_activator    users @relation(fields: [user_activator_id], references: [id])
     */

    created_at DateTime @default(now())
    updated_at DateTime @default(now()) @updatedAt
}

model queue_members {
    id Int @id @default(autoincrement())

    queue    queues @relation(fields: [queue_id], references: [id])
    queue_id Int

    user    users @relation(fields: [user_id], references: [id])
    user_id Int

    space    spaces @relation(fields: [space_id], references: [id])
    space_id Int

    is_paused  Boolean @default(false)
    is_current Boolean @default(false)
    position   Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    subject String?

    has_spoken Boolean @default(false)

    queue_ended Boolean @default(false)
}

model space_owners {
    id Int @id @default(autoincrement())

    space_id Int
    space    spaces @relation(fields: [space_id], references: [id])

    user_id Int
    user    users @relation(fields: [user_id], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}
